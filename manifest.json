{
  "manifest_version": 3,
  "name": "WebMCP Local Agent",
  "key": "",
  "version": "0.7.15",
  "description": "Chat with local Ollama and let it call the WebMCP tools exposed by the active page.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "activeTab", "scripting", "storage", "tabs", "webNavigation", "tabCapture", "offscreen", "downloads", "desktopCapture"],
  "host_permissions": [
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "https://github.com/*",
    "https://api.github.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open WebMCP Local Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/webmcp-schema.js", "page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["virtual-cursor.js", "content.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ]
}
